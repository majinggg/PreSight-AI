# Get a key from https://app.tavily.com/
TAVILY_API_KEY=tvly-your-key-here
PORT=5173

# Used to turn search results into dynamic market analysis
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=claude-sonnet-5
OPENAI_BASE_URL=https://litellm.spaccez.com

# AdsPower Local API (the desktop app must be running)
ADSPOWER_API_BASE=http://127.0.0.1:50325
ADSPOWER_PROFILE_ID=your-adspower-profile-id
# Only required if AdsPower Local API security is enabled
ADSPOWER_API_KEY=

# Sensor Tower URL used inside the AdsPower profile
SENSORTOWER_URL=https://app.sensortower-china.com/
